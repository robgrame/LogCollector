{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request;Exception"
      }
    },
    "logLevel": {
      "default": "Information",
      "LogCollector": "Information"
    }
  },
  "extensions": {
    "serviceBus": {
      "autoCompleteMessages": false,
      "maxAutoLockRenewalDuration": "00:10:00",
      "prefetchCount": 0,
      "maxConcurrentCalls": 8,
      "maxMessageBatchSize": 1
    }
  }
}
